# Iron & Breath — production environment.
# Copy to ".env" in the repo root (next to docker-compose.prod.yml) and fill in.
# The installer (./install.sh) creates this for you and generates JWT_KEY.

# REQUIRED. Secret used to sign login tokens. Must be a long random string
# (>= 32 bytes). Generate one with:  openssl rand -hex 32
JWT_KEY=

# Public address Caddy serves on.
#   :80               -> plain HTTP, access by the droplet's IP (default)
#   gym.example.com   -> automatic HTTPS (point the domain's DNS at the droplet first)
SITE_ADDRESS=:80

# OPTIONAL. Enables Google sign-in. OAuth 2.0 Web Client ID from Google Cloud.
# Add your site origin (https://your-domain) to the client's authorised origins.
GOOGLE_CLIENT_ID=

# OPTIONAL. Enables the full AI coach (Anthropic Claude). Empty = offline demo coach.
CLAUDE_API_KEY=
