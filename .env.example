# Copy to .env (next to docker-compose.yml) and fill in.
# docker compose reads these automatically.

# REQUIRED for any real deployment: a long random string, at least 32 bytes.
JWT_KEY=please-change-this-to-a-long-random-string-min-32-bytes

# OPTIONAL: enables Google sign-in. OAuth 2.0 Web Client ID from Google Cloud.
# Leave empty to disable Google (email/password still works).
GOOGLE_CLIENT_ID=

# OPTIONAL: enables the full AI coach (Anthropic Claude). Leave empty to use the
# built-in offline demo coach.
CLAUDE_API_KEY=
