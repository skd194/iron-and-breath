# Keep shell scripts and container/config files as LF so they run on Linux
# droplets regardless of the OS they were committed from.
*.sh            text eol=lf
install.sh      text eol=lf
Caddyfile       text eol=lf
deploy/Caddyfile text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
nginx.conf      text eol=lf
.env.example    text eol=lf
